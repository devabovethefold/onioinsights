---
import HeroImage from '@icons/hero.svg'

interface Props {
  title: string
  subtitle?: string
}

const {title, subtitle} = Astro.props
const pathname = Astro.url.pathname
---

{
  pathname === '/' ? (
    <header class="py-content format md:split-5/9 min-h-screen items-center">
      <div class="item space-y-8">
        <hgroup class="space-y-4!">
          <h1>Make Your Brand Discoverable</h1>
          <p>Onio Insights helps marketers measure and grow their brand visibility across the modern web.</p>
        </hgroup>
        <div class="flex gap-2">
          <a class="btn" href="#">
            Contact Us
          </a>
          <a class="btn btn-transparent" href="#">
            About Us
          </a>
        </div>
      </div>
      <div class="item">
        <img
          src={HeroImage.src}
          alt="Hero Image"
          class="h-auto w-full object-fill"
        />
      </div>
    </header>
  ) : (
    <header class="py-hero breakout text-center">
      <hgroup>
        {subtitle && <p>{subtitle}</p>}
        <h2>{title}</h2>
      </hgroup>
    </header>
  )
}

