---
import {getImage} from 'astro:assets'

import HeroImage from '@icons/hero.svg'
import bgHero from '@images/bg-hero.jpg'

interface Props {
  title: string
  subtitle?: string
}

const backgroundHero = await getImage({src: bgHero, format: 'avif'})
const {title, subtitle} = Astro.props
const pathname = Astro.url.pathname
---

{
  pathname === '/' ? (
    <header class="py-content format md:split-5/9 min-h-screen items-center">
      <div class="item space-y-8">
        <hgroup class="space-y-4!">
          <h1>Make Your Brand Discoverable</h1>
          <p>
            Onio Insights helps marketers measure and grow their brand visibility across the modern
            web.
          </p>
        </hgroup>
        <div class="flex gap-2">
          <a class="btn" href="/contact">
            Contact Us
          </a>
          <a class="btn btn-transparent" href="/about">
            About Us
          </a>
        </div>
      </div>
      <div class="item hidden md:block">
        <img src={HeroImage.src} alt="Hero Image" class="h-auto w-full object-fill" />
      </div>
    </header>
  ) : (
    <header class="py-hero text-center">
      <hgroup>
        {subtitle && <p>{subtitle}</p>}
        <h2>{title}</h2>
      </hgroup>
    </header>
  )
}

<style>
  @import '@styles/landmarks/hero.css';
</style>
