---
import {Icon} from 'astro-icon/components'
---

<footer class="format pt-16 pb-4 text-gray-900">
  <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-12">
    <!-- Newsletter / Logo -->
    <div class="flex flex-col justify-start md:col-span-6">
      <a href="/" class="font-script mb-6 text-4xl text-black">Logo</a>
      <p class="mb-4 max-w-sm text-base text-gray-700">
        Get insights and updates delivered straight to your inbox.
      </p>

      <form class="mb-3 flex max-w-md gap-4">
        <input
          type="email"
          placeholder="Your email"
          class="flex-1 rounded-none border border-gray-400 bg-transparent px-4 py-3 text-base focus:border-black focus:outline-none"
        />
        <button
          type="submit"
          class="!rounded-none !border !border-gray-500 !bg-white px-6 py-3 text-base font-medium !text-black transition-colors duration-200 hover:!bg-black hover:!text-white"
        >
          Subscribe
        </button>
      </form>

      <p class="max-w-sm text-xs leading-relaxed text-gray-500">
        By subscribing you agree to our Privacy Policy and consent to receive updates from Onio
        Insights.
      </p>
    </div>

    <!-- Services -->
    <div class="md:col-span-2">
      <h4 class="mb-4 text-base font-bold text-black">Services</h4>
      <ul class="space-y-3 text-sm text-gray-700">
        <li><a href="#" class="transition-colors hover:text-black">SEO audit</a></li>
        <li><a href="#" class="transition-colors hover:text-black">On-page SEO</a></li>
        <li><a href="#" class="transition-colors hover:text-black">Technical SEO</a></li>
        <li><a href="#" class="transition-colors hover:text-black">Local SEO</a></li>
        <li><a href="#" class="transition-colors hover:text-black">Link building</a></li>
      </ul>
    </div>

    <!-- Company -->
    <div class="md:col-span-2">
      <h4 class="mb-4 text-base font-bold text-black">Company</h4>
      <ul class="space-y-3 text-sm text-gray-700">
        <li><a href="#" class="transition-colors hover:text-black">About us</a></li>
        <li><a href="#" class="transition-colors hover:text-black">Case studies</a></li>
        <li><a href="#" class="transition-colors hover:text-black">Blog</a></li>
        <li><a href="#" class="transition-colors hover:text-black">Contact</a></li>
        <li><a href="#" class="transition-colors hover:text-black">Resources</a></li>
      </ul>
    </div>

    <!-- Follow us -->
    <div class="md:col-span-2">
      <h4 class="mb-4 text-base font-bold text-black">Follow us</h4>
      <ul class="space-y-3 text-sm text-gray-700">
        <li>
          <a href="#" class="flex items-center gap-3 transition-colors hover:text-black">
            <Icon name="mdi:facebook" class="text-xl text-black" />
            <span>Facebook</span>
          </a>
        </li>
        <li>
          <a href="#" class="flex items-center gap-3 transition-colors hover:text-black">
            <Icon name="mdi:instagram" class="text-xl text-black" />
            <span>Instagram</span>
          </a>
        </li>
        <li>
          <a href="#" class="flex items-center gap-3 transition-colors hover:text-black">
            <Icon name="mdi:twitter" class="text-xl text-black" />
            <span>X</span>
          </a>
        </li>
        <li>
          <a href="#" class="flex items-center gap-3 transition-colors hover:text-black">
            <Icon name="mdi:linkedin" class="text-xl text-black" />
            <span>LinkedIn</span>
          </a>
        </li>
        <li>
          <a href="#" class="flex items-center gap-3 transition-colors hover:text-black">
            <Icon name="mdi:youtube" class="text-xl text-black" />
            <span>YouTube</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <hr class="mt-12 mb-6 border-gray-300" />

  <div
    class="flex flex-col-reverse items-center justify-between gap-4 text-sm text-gray-700 md:flex-row"
  >
    <p>© {new Date().getFullYear()} Onio Insights. All rights reserved.</p>
    <ul class="flex gap-6">
      <li><a href="#" class="underline transition-colors hover:text-black">Privacy policy</a></li>
      <li><a href="#" class="underline transition-colors hover:text-black">Terms of service</a></li>
      <li><a href="#" class="underline transition-colors hover:text-black">Cookie settings</a></li>
    </ul>
  </div>
</footer>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Alex+Brush&display=swap');
  .font-script {
    font-family: 'Alex Brush', cursive;
  }
</style>
