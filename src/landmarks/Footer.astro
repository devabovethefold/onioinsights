---
import {Icon} from 'astro-icon/components'

import Logo from '../components/Logo.astro'
---

<footer class="format lg:split-2 pt-copy">
  <div class="wrap gap-y-6">
    <div class="item">
      <a href="/">
        <Logo class="mb-3 h-10 w-auto" />
      </a>
      <p class="mb-4 max-w-sm text-base">
        Get insights and updates delivered straight to your inbox.
      </p>
      <form class="mb-3 flex max-w-md gap-4">
        <input
          type="email"
          placeholder="Your email"
          class="border-neutral-md bg-neutral-lo grow rounded-none border px-4 py-3 text-base"
        />
        <button type="submit">Subscribe</button>
      </form>
      <p class="max-w-sm text-xs leading-relaxed">
        By subscribing you agree to our Privacy Policy and consent to receive updates from Onio
        Insights.
      </p>
    </div>
    <div class="item grid grid-cols-3">
      <!-- Services -->
      <div>
        <h4 class="mb-4 text-base!">Services</h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="/services/seo-audit">SEO audit</a>
          </li>
          <li>
            <a href="/services/on-page-seo">On-page SEO</a>
          </li>
          <li>
            <a href="/services/technical-seo">Technical SEO</a>
          </li>
          <li>
            <a href="/services/local-seo">Local SEO</a>
          </li>
          <li>
            <a href="/services/link-building">Link building</a>
          </li>
        </ul>
      </div>
      <!-- Company -->
      <div>
        <h4 class="mb-4 text-base!">Company</h4>
        <ul class="space-y-3 text-sm">
          <li><a href="#">About us</a></li>
          <li><a href="#">Case studies</a></li>
          <li><a href="#">Blog</a></li>
          <li><a href="#">Contact</a></li>
          <li><a href="#">Resources</a></li>
        </ul>
      </div>
      <!-- Follow us -->
      <div>
        <h4 class="mb-4 text-base!">Follow us</h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="#" class="flex items-center gap-3">
              <Icon name="mdi:facebook" class="text-xl" />
              <span>Facebook</span>
            </a>
          </li>
          <li>
            <a href="#" class="flex items-center gap-3">
              <Icon name="mdi:instagram" class="text-xl" />
              <span>Instagram</span>
            </a>
          </li>
          <li>
            <a href="#" class="flex items-center gap-3">
              <Icon name="mdi:twitter" class="text-xl" />
              <span>X</span>
            </a>
          </li>
          <li>
            <a href="#" class="flex items-center gap-3">
              <Icon name="mdi:linkedin" class="text-xl" />
              <span>LinkedIn</span>
            </a>
          </li>
          <li>
            <a href="#" class="flex items-center gap-3">
              <Icon name="mdi:youtube" class="text-xl" />
              <span>YouTube</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <hr class="border-neutral-lo mt-12 mb-6" />

  <div class="dark flex flex-col-reverse items-center justify-between gap-4 text-sm md:flex-row">
    <p class="mb-0!">© {new Date().getFullYear()} Onio Insights. All rights reserved.</p>
    <ul class="flex gap-6">
      <li><a href="#" class="underline">Privacy policy</a></li>
      <li><a href="#" class="underline">Terms of service</a></li>
      <li><a href="#" class="underline">Cookie settings</a></li>
    </ul>
  </div>
</footer>
