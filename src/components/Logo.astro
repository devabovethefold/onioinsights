---
interface Props {
  class?: string
}

const {class: className} = Astro.props
---

<svg
  viewBox="0 0 220 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-label="Onio Insights Logo"
>
  <!-- Geometric 'O' Icon -->
  <circle
    cx="20"
    cy="20"
    r="14"
    stroke="currentColor"
    stroke-width="5"
    class="text-[#1a5231]"
  />
  <circle
    cx="20"
    cy="20"
    r="6"
    fill="currentColor"
    class="text-[#1a5231]"
  />

  <!-- Wordmark -->
  <text
    x="45"
    y="29"
    font-family="Inter, system-ui, sans-serif"
    font-size="24"
    font-weight="700"
    letter-spacing="-0.02em"
    fill="currentColor"
    class="text-[#071424] dark:text-white"
  >Onio</text>
  <text
    x="104"
    y="29"
    font-family="Inter, system-ui, sans-serif"
    font-size="24"
    font-weight="400"
    letter-spacing="-0.02em"
    fill="currentColor"
    class="text-[#1a5231]"
  >Insights</text>
</svg>
