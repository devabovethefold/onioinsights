  <!-- CONTACT FORM -->
  <div class="item">
    <div class="surface rounded-3xl p-8 shadow-2xl!">
      <form class="space-y-6">
        <!-- Form Select -->
        <div>
          <select
            class="border-neutral-md bg-neutral-lo focus:border-info-hi focus:ring-info-hi block w-full rounded-xl p-4 text-sm outline-hidden"
          >
            <option selected>This question is about...</option>
            <option>Registering/Authorising</option>
            <option>Using Application</option>
            <option>Troubleshooting</option>
            <option>Backup/Restore</option>
            <option>Other</option>
          </select>
        </div>
        <!-- Contact Form Input -->
        <div>
          <input
            type="text"
            name="name"
            class="border-neutral-md bg-neutral-lo focus:border-info-hi focus:ring-info-hi block w-full rounded-xl p-4 text-sm outline-hidden"
            placeholder="Your Name*"
          />
        </div>
        <div>
          <input
            type="email"
            name="email"
            class="border-neutral-md bg-neutral-lo focus:border-info-hi focus:ring-info-hi block w-full rounded-xl p-4 text-sm outline-hidden"
            placeholder="Email Address*"
          />
        </div>
        <div>
          <textarea
            class="border-neutral-md bg-neutral-lo focus:border-info-hi focus:ring-info-hi block w-full rounded-xl p-4 text-sm outline-hidden"
            name="message"
            rows="6"
            placeholder="I have a problem with..."
          ></textarea>
        </div>
        <!-- Contact Form Button -->
        <div class="form-btn">
          <button
            type="submit"
            class="bg-info-hi hover:bg-info-md w-full rounded-xl py-4 font-bold text-white shadow-lg transition-all active:scale-95"
          >
            Submit Request
          </button>
        </div>
      </form>
    </div>
  </div>
</section>
