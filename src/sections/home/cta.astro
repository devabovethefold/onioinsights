---
import {Image, getImage} from 'astro:assets'
import bgImage from '@images/cta-bg.png'

const optimizedBackground = await getImage({src: bgImage, format: 'avif'})
---

<section class="breakout py-0!">
  <div
    class="wrap p-copy gap-y-6 rounded-3xl"
    style={{
      backgroundImage: `url(${optimizedBackground.src})`,
      backgroundSize: 'cover',
      backgroundPosition: 'center',
    }}
  >
    <div class="max-w-2xl">
      <header>
        <hgroup>
          <p class="text-success-on!">Get Started Today</p>
          <h2 class="text-success-on!">Ready to elevate your digital presence?</h2>
        </hgroup>
      </header>
      <p class="mt-6 text-lg leading-relaxed text-neutral-100 md:text-xl">
        Leverage data-driven insights to guide your brand through the evolving landscape of digital
        discovery.
      </p>
    </div>

    <div class="flex-shrink-0">
      <a href="/contact" class="btn">Get Started</a>
    </div>
  </div>
</section>
