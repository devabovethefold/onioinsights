---
import Icon01 from '@icons/01.svg'
import Icon02 from '@icons/02.svg'
import Icon03 from '@icons/03.svg'
---

<section id="benefits" class="lg:split-3 space-y-4 text-center">
  <header class="mx-auto max-w-3xl">
    <hgroup>
      <p>Our Advantages</p>
      <h2>Empowering Your Digital Discovery</h2>
    </hgroup>
  </header>
  <ul class="wrap grid-rows-[repeat(4,_auto)] gap-y-2">
    <li class="item tile row-span-4 grid grid-rows-subgrid py-6 text-center">
      <Icon01 class="mx-auto mb-6 h-45 w-auto" />
      <header>
        <h3 class="text-h4!">Actionable Analytics</h3>
      </header>
      <p>
        Uncover deep insights into how users discover your brand across search engines and AI
        platforms.
      </p>
      <a href="#" class="btn btn-transparent mx-auto">Learn More</a>
    </li>
    <li class="item tile row-span-4 grid grid-rows-subgrid py-6 text-center">
      <Icon02 class="mx-auto mb-6 h-45 w-auto" />
      <header>
        <h3 class="text-h4!">Strategic Agility</h3>
      </header>
      <p>
        Adapt to algorithm shifts quickly with data-driven strategies designed for long-term
        visibility.
      </p>
      <a href="#" class="btn btn-transparent mx-auto">Learn More</a>
    </li>
    <li class="item tile row-span-4 grid grid-rows-subgrid py-6 text-center">
      <Icon03 class="mx-auto mb-6 h-45 w-auto" />
      <header>
        <h3 class="text-h4!">Authoritative Presence</h3>
      </header>
      <p>
        Establish and maintain your brand as a trusted leader in your industry's evolving digital
        landscape.
      </p>
      <a href="#" class="btn btn-transparent mx-auto">Learn More</a>
    </li>
  </ul>
</section>
