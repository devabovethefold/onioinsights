---
import Layout from '@layouts/Common.astro'
import {Icon} from 'astro-icon/components'
---

<Layout>
  <!-- Hero Section -->
  <section class="md:split-2">
    <div class="item reveal left-10 duration-600 flex flex-col justify-center">
      <h1 class="text-primary font-extrabold">Built on experience and driven by results</h1>
      <p class="mt-4 text-base">
        Over a decade in digital marketing taught me that SEO works best when it's personal. I've
        helped local South Florida businesses compete nationally and guided national brands through
        complex markets. Every strategy starts with understanding your business, not just your
        keywords.
      </p>
      <div class="mt-6 flex gap-4">
        <button class="bg-primary rounded px-6 py-3 text-white">Learn More</button>
        <button class="border-primary text-primary rounded border px-6 py-3">Contact Us</button>
      </div>
    </div>
    <div class="item reveal right-10 duration-600">
      <img
        src="https://images.pexels.com/photos/3184292/pexels-photo-3184292.jpeg?auto=compress&cs=tinysrgb&w=1200"
        alt="SEO team working on search strategy"
        class="w-full rounded object-cover"
      />
    </div>
  </section>

  <!-- Stats -->
  <section class="md:split-2">
    <div class="item reveal left-10 duration-500">
      <p class="text-primary text-sm font-semibold">Proven</p>
      <h2 class="text-h2 mt-2 font-bold">The numbers speak for themselves</h2>
      <p class="mt-4 text-base">
        We've helped over 150 businesses climb the search rankings and capture qualified traffic.
        The results are measurable, consistent, and built to last.
      </p>
      <div class="mt-6 flex items-center gap-4">
        <a
          href="/services"
          class="border border-gray-500 px-6 py-2 text-black transition-colors duration-200 hover:bg-black hover:text-white dark:border-gray-400 dark:text-white"
        >
          Learn
        </a>
        <a href="/contact" class="flex items-center gap-1 font-semibold text-black dark:text-white">
          Contact <Icon name="mdi:chevron-right" class="size-5" />
        </a>
      </div>
    </div>

    <div class="item reveal right-10 duration-500 grid grid-cols-2 gap-6 stagger-100ms">
      <div class="reveal up-6 duration-400 flex flex-col justify-center border border-black p-8 text-center dark:border-white">
        <p class="text-5xl font-extrabold text-black dark:text-white">150+</p>
        <p class="mt-2 text-sm font-bold text-black dark:text-white">Clients served</p>
      </div>
      <div class="reveal up-6 duration-400 flex flex-col justify-center border border-black p-8 text-center dark:border-white">
        <p class="text-5xl font-extrabold text-black dark:text-white">287%</p>
        <p class="mt-2 text-sm font-bold text-black dark:text-white">Average traffic gain</p>
      </div>
      <div class="reveal up-6 duration-400 flex flex-col justify-center border border-black p-8 text-center dark:border-white">
        <p class="text-5xl font-extrabold text-black dark:text-white">4.2</p>
        <p class="mt-2 text-sm font-bold text-black dark:text-white">Years average partnership</p>
      </div>
      <div class="reveal up-6 duration-400 flex flex-col justify-center border border-black p-8 text-center dark:border-white">
        <p class="text-5xl font-extrabold text-black dark:text-white">89%</p>
        <p class="mt-2 text-sm font-bold text-black dark:text-white">Reach top three rankings</p>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section>
    <hgroup class="mx-auto max-w-lg text-center reveal up-6 duration-500">
      <p class="text-primary text-sm font-semibold">Strategy</p>
      <h2 class="text-h2 mt-2 font-bold">The specialist</h2>
      <p class="mt-4 text-base">
        Ten years of SEO work, hundreds of successful campaigns, and a relentless focus on what
        actually moves the needle.
      </p>
    </hgroup>
  </section>

  <section class="md:split-3 stagger-150ms">
    <div class="item reveal up-10 duration-500 border p-6 text-center">
      <img
        src="https://images.pexels.com/photos/2379004/pexels-photo-2379004.jpeg?auto=compress&cs=tinysrgb&w=300"
        alt="David Ortiz - SEO Specialist"
        class="mx-auto size-24 rounded-full object-cover"
      />
      <h4 class="text-h4 mt-4 font-bold">David Ortiz</h4>
      <p class="text-primary text-sm font-semibold">SEO Specialist</p>
      <p class="text-sm">
        Built Onio Insights on the belief that SEO should be transparent, strategic, and tied
        directly to business growth.
      </p>
      <div class="text-primary mt-4 flex justify-center gap-2">
        <a href="#"><Icon name="mdi:linkedin" class="size-6" /></a>
        <a href="#"><Icon name="mdi:twitter" class="size-6" /></a>
      </div>
    </div>

    <div class="item reveal up-10 duration-500 border p-6 text-center">
      <img
        src="https://images.pexels.com/photos/3756679/pexels-photo-3756679.jpeg?auto=compress&cs=tinysrgb&w=300"
        alt="Elena Vasquez - Content Strategist"
        class="mx-auto size-24 rounded-full object-cover"
      />
      <h4 class="text-h4 mt-4 font-bold">Elena Vasquez</h4>
      <p class="text-primary text-sm font-semibold">Content Strategist</p>
      <p class="text-sm">
        Crafts content that ranks and resonates. Knows how to turn keywords into stories that
        convert.
      </p>
      <div class="text-primary mt-4 flex justify-center gap-2">
        <a href="#"><Icon name="mdi:linkedin" class="size-6" /></a>
        <a href="#"><Icon name="mdi:twitter" class="size-6" /></a>
      </div>
    </div>

    <div class="item reveal up-10 duration-500 border p-6 text-center">
      <img
        src="https://images.pexels.com/photos/1222271/pexels-photo-1222271.jpeg?auto=compress&cs=tinysrgb&w=300"
        alt="Marcus Thompson - Technical SEO Lead"
        class="mx-auto size-24 rounded-full object-cover"
      />
      <h4 class="text-h4 mt-4 font-bold">Marcus Thompson</h4>
      <p class="text-primary text-sm font-semibold">Technical SEO Lead</p>
      <p class="text-sm">
        Fixes the broken foundations. Handles site speed, crawlability, and the technical details
        that matter.
      </p>
      <div class="text-primary mt-4 flex justify-center gap-2">
        <a href="#"><Icon name="mdi:linkedin" class="size-6" /></a>
        <a href="#"><Icon name="mdi:twitter" class="size-6" /></a>
      </div>
    </div>
  </section>

  <!-- Partners -->
  <section class="md:split-2">
    <hgroup class="item reveal left-10 duration-500 flex flex-col justify-center">
      <h2 class="text-h2 font-bold">Recognized by the industry leaders</h2>
      <p class="mt-4 text-base">
        Certified partners and award winners. We stay current with the tools and standards that
        matter in SEO.
      </p>
    </hgroup>

    <div class="item format split-2 stagger-100ms">
      <div class="item reveal up-4 duration-300 flex justify-center">
        <img src="https://d22po4pjz3o32e.cloudfront.net/webflow-logo.svg" alt="Webflow" class="h-12" />
      </div>
      <div class="item reveal up-4 duration-300 flex justify-center">
        <img src="https://d22po4pjz3o32e.cloudfront.net/webflow-logo.svg" alt="Webflow" class="h-12" />
      </div>
      <div class="item reveal up-4 duration-300 flex justify-center">
        <img src="https://d22po4pjz3o32e.cloudfront.net/relume-logo.svg" alt="Relume" class="h-12" />
      </div>
      <div class="item reveal up-4 duration-300 flex justify-center">
        <img src="https://d22po4pjz3o32e.cloudfront.net/relume-logo.svg" alt="Relume" class="h-12" />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section>
    <hgroup class="mx-auto w-lg text-center reveal up-6 duration-500">
      <h2>Questions</h2>
      <p class="text-base">Everything you need to know about how we work and what to expect</p>
    </hgroup>

    <div class="mx-auto mt-12 flex w-2xl max-w-full flex-col gap-4">
      <details class="reveal up-4 duration-400 w-full rounded border p-4">
        <summary class="flex cursor-pointer items-center justify-between font-bold">
          How long until results?
          <Icon name="mdi:chevron-down" />
        </summary>
        <p class="mt-4 text-sm">
          SEO is not a sprint. Most clients see meaningful movement in three to four months, with
          stronger gains by month six. We focus on sustainable growth, not quick fixes that fade.
        </p>
      </details>

      <details class="reveal up-4 duration-400 w-full rounded border p-4">
        <summary class="flex cursor-pointer items-center justify-between font-bold">
          What makes you different?
          <Icon name="mdi:chevron-down" />
        </summary>
        <p class="mt-4 text-sm">
          We don't use templates or automation. Every strategy is built from scratch based on your
          market, competitors, and goals.
        </p>
      </details>
    </div>
  </section>
</Layout>
