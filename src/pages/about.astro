---
import Layout from '@layouts/Common.astro'
import {Icon} from 'astro-icon/components'
---

<Layout>
  <!-- Hero Section (Layout22) -->
  <section class="split-2">
    <div class="item flex flex-col justify-center">
      <img
        src="https://d22po4pjz3o32e.cloudfront.net/relume-icon.svg"
        alt="Relume icon"
        class="mb-6 size-16"
      />
      <h1 class="text-primary font-extrabold">Built on experience and driven by results</h1>
      <p class="mt-4 text-base">
        Over a decade in digital marketing taught me that SEO works best when it's personal. I've
        helped local South Florida businesses compete nationally and guided national brands through
        complex markets. Every strategy starts with understanding your business, not just your
        keywords.
      </p>
      <div class="mt-6 flex gap-4">
        <button class="bg-primary rounded px-6 py-3 text-white">Learn More</button>
        <button class="border-primary text-primary rounded border px-6 py-3">Contact Us</button>
      </div>
    </div>
    <div class="item">
      <img
        src="https://d22po4pjz3o32e.cloudfront.net/placeholder-image.svg"
        alt="About us"
        class="w-full rounded object-cover"
      />
    </div>
  </section>

  <!-- Stats55 -->
  <section class="split-2">
    <div class="item">
      <p class="text-primary text-sm font-semibold">Proven</p>
      <h2 class="text-h2 mt-2 font-bold">The numbers speak for themselves</h2>
      <p class="mt-4 text-base">
        We've helped over 150 businesses climb the search rankings and capture qualified traffic.
        The results are measurable, consistent, and built to last.
      </p>
      <div class="mt-6 flex gap-4">
        <button class="border-primary text-primary rounded border px-6 py-2">Our Work</button>
      </div>
    </div>

    <div class="item format split-2">
      <div class="item border p-6 text-center">
        <p class="text-h1 text-primary font-extrabold">150+</p>
        <h4 class="mt-2 font-semibold">Clients served</h4>
      </div>
      <div class="item border p-6 text-center">
        <p class="text-h1 text-primary font-extrabold">287%</p>
        <h4 class="mt-2 font-semibold">Average traffic gain</h4>
      </div>
      <div class="item border p-6 text-center">
        <p class="text-h1 text-primary font-extrabold">4.2</p>
        <h4 class="mt-2 font-semibold">Years average partnership</h4>
      </div>
      <div class="item border p-6 text-center">
        <p class="text-h1 text-primary font-extrabold">89%</p>
        <h4 class="mt-2 font-semibold">Reach top three rankings</h4>
      </div>
    </div>
  </section>

  <!-- Team5 -->
  <section>
    <hgroup class="mx-auto max-w-lg text-center">
      <p class="text-primary text-sm font-semibold">Strategy</p>
      <h2 class="text-h2 mt-2 font-bold">The specialist</h2>
      <p class="mt-4 text-base">
        Ten years of SEO work, hundreds of successful campaigns, and a relentless focus on what
        actually moves the needle.
      </p>
    </hgroup>
  </section>

  <section class="split-3">
    <div class="item border p-6 text-center">
      <img
        src="https://d22po4pjz3o32e.cloudfront.net/placeholder-image.svg"
        alt="David Ortiz"
        class="mx-auto size-24 rounded-full"
      />
      <h4 class="text-h4 mt-4 font-bold">David Ortiz</h4>
      <p class="text-primary text-sm font-semibold">SEO Specialist</p>
      <p class="text-sm">
        Built Onio Insights on the belief that SEO should be transparent, strategic, and tied
        directly to business growth.
      </p>
      <div class="text-primary mt-4 flex justify-center gap-2">
        <a href="#"><Icon name="mdi:linkedin" class="size-6" /></a>
        <a href="#"><Icon name="mdi:twitter" class="size-6" /></a>
      </div>
    </div>

    <div class="item border p-6 text-center">
      <img
        src="https://d22po4pjz3o32e.cloudfront.net/placeholder-image.svg"
        alt="Elena Vasquez"
        class="mx-auto size-24 rounded-full"
      />
      <h4 class="text-h4 mt-4 font-bold">Elena Vasquez</h4>
      <p class="text-primary text-sm font-semibold">Content Strategist</p>
      <p class="text-sm">
        Crafts content that ranks and resonates. Knows how to turn keywords into stories that
        convert.
      </p>
      <div class="text-primary mt-4 flex justify-center gap-2">
        <a href="#"><Icon name="mdi:linkedin" class="size-6" /></a>
        <a href="#"><Icon name="mdi:twitter" class="size-6" /></a>
      </div>
    </div>

    <div class="item border p-6 text-center">
      <img
        src="https://d22po4pjz3o32e.cloudfront.net/placeholder-image.svg"
        alt="Marcus Thompson"
        class="mx-auto size-24 rounded-full"
      />
      <h4 class="text-h4 mt-4 font-bold">Marcus Thompson</h4>
      <p class="text-primary text-sm font-semibold">Technical SEO Lead</p>
      <p class="text-sm">
        Fixes the broken foundations. Handles site speed, crawlability, and the technical details
        that matter.
      </p>
      <div class="text-primary mt-4 flex justify-center gap-2">
        <a href="#"><Icon name="mdi:linkedin" class="size-6" /></a>
        <a href="#"><Icon name="mdi:twitter" class="size-6" /></a>
      </div>
    </div>
  </section>

  <!-- Logo4 -->
  <section class="split-2">
    <hgroup class="item flex flex-col justify-center">
      <h2 class="text-h2 font-bold">Recognized by the industry leaders</h2>
      <p class="mt-4 text-base">
        Certified partners and award winners. We stay current with the tools and standards that
        matter in SEO.
      </p>
    </hgroup>

    <div class="item format split-2">
      <div class="item flex justify-center">
        <img
          src="https://d22po4pjz3o32e.cloudfront.net/webflow-logo.svg"
          alt="Webflow logo"
          class="h-12"
        />
      </div>
      <div class="item flex justify-center">
        <img
          src="https://d22po4pjz3o32e.cloudfront.net/webflow-logo.svg"
          alt="Webflow logo"
          class="h-12"
        />
      </div>
      <div class="item flex justify-center">
        <img
          src="https://d22po4pjz3o32e.cloudfront.net/relume-logo.svg"
          alt="Relume logo"
          class="h-12"
        />
      </div>
      <div class="item flex justify-center">
        <img
          src="https://d22po4pjz3o32e.cloudfront.net/relume-logo.svg"
          alt="Relume logo"
          class="h-12"
        />
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section>
    <hgroup class="mx-auto max-w-lg text-center">
      <h2>Questions</h2>
      <p class="text-base">Everything you need to know about how we work and what to expect</p>
    </hgroup>

    <div class="mx-auto mt-12 flex max-w-2xl flex-col gap-4">
      <details class="rounded border p-4">
        <summary class="flex cursor-pointer items-center justify-between font-bold">
          How long until results?
          <Icon name="mdi:chevron-down" />
        </summary>
        <p class="mt-4 text-sm">
          SEO is not a sprint. Most clients see meaningful movement in three to four months, with
          stronger gains by month six. We focus on sustainable growth, not quick fixes that fade.
        </p>
      </details>

      <details class="rounded border p-4">
        <summary class="flex cursor-pointer items-center justify-between font-bold">
          What makes you different?
          <Icon name="mdi:chevron-down" />
        </summary>
        <p class="mt-4 text-sm">
          We don't use templates or automation. Every strategy is built from scratch based on your
          market, competitors, and goals.
        </p>
      </details>
    </div>
  </section>
</Layout>
