---
import Layout from '@layouts/Common.astro'
import {Icon} from 'astro-icon/components'
---

<Layout>
  <!-- Hero Section -->
  <section class="split-2 relative">
    <div class="item relative z-10">
      <p class="text-primary text-sm font-semibold">Reach</p>
      <h1 class="mt-2 font-extrabold text-white">Get in touch</h1>
      <p class="mt-4 text-base text-white">
        Have questions about SEO or ready to start? We're here to help.
      </p>
    </div>
    <div class="absolute inset-0 z-0">
      <img
        src="https://d22po4pjz3o32e.cloudfront.net/placeholder-image.svg"
        alt="Contact background"
        class="size-full object-cover"
      />
      <div class="absolute inset-0 bg-black/60"></div>
    </div>
  </section>

  <!-- Contact Info & Form -->
  <section class="split-2">
    <header class="item flex flex-col justify-center">
      <h2 class="text-h2 font-bold">How to reach us</h2>
      <p class="mt-4 mb-8 text-base">Choose the way that works best for you.</p>

      <div class="flex flex-col gap-6">
        <div class="flex items-center gap-4">
          <div class="bg-primary/10 text-primary rounded-full p-3">
            <Icon name="mdi:email" class="size-6" />
          </div>
          <div>
            <h3 class="font-bold">Email</h3>
            <a href="mailto:hello@onioinsights.com" class="text-primary hover:underline">
              hello@onioinsights.com
            </a>
          </div>
        </div>

        <div class="flex items-center gap-4">
          <div class="bg-primary/10 text-primary rounded-full p-3">
            <Icon name="mdi:phone" class="size-6" />
          </div>
          <div>
            <h3 class="font-bold">Phone</h3>
            <a href="tel:+15615550147" class="text-primary hover:underline">+1 (561) 555-0147</a>
          </div>
        </div>

        <div class="flex items-center gap-4">
          <div class="bg-primary/10 text-primary rounded-full p-3">
            <Icon name="mdi:map-marker" class="size-6" />
          </div>
          <div>
            <h3 class="font-bold">Office</h3>
            <p class="text-gray-600">Fort Lauderdale, Florida 33301 USA</p>
          </div>
        </div>
      </div>
    </header>

    <div class="item rounded-lg border bg-white p-8 shadow-sm">
      <h3 class="text-h3 mb-6 font-bold">Send us a message</h3>
      <form class="flex flex-col gap-4">
        <div>
          <label for="name" class="mb-1 block text-sm font-semibold">Name</label>
          <input type="text" id="name" class="w-full rounded border p-3" placeholder="Your name" />
        </div>
        <div>
          <label for="email" class="mb-1 block text-sm font-semibold">Email</label>
          <input
            type="email"
            id="email"
            class="w-full rounded border p-3"
            placeholder="Your email"
          />
        </div>
        <div>
          <label for="message" class="mb-1 block text-sm font-semibold">Message</label>
          <textarea
            id="message"
            placeholder="Tell us about your goals"
            class="min-h-[120px] w-full rounded border p-3"
          >
          </textarea>
        </div>
        <div class="flex items-center gap-2">
          <input type="checkbox" id="terms" class="text-primary focus:ring-primary rounded" />
          <label for="terms" class="cursor-pointer text-xs text-gray-600">
            I agree to the privacy policy
          </label>
        </div>
        <button
          type="submit"
          class="bg-primary hover:bg-primary/90 mt-2 rounded px-6 py-3 font-semibold text-white transition-colors"
        >
          Send Message
        </button>
      </form>
    </div>
  </section>

  <!-- FAQ Section -->
  <section>
    <hgroup class="mx-auto max-w-lg text-center">
      <h2>Questions</h2>
      <p class="text-base">Everything you need to know about how we work and what to expect</p>
    </hgroup>

    <div class="mx-auto mt-12 flex max-w-2xl flex-col gap-4">
      <details class="w-full rounded border p-4">
        <summary class="flex cursor-pointer items-center justify-between font-bold">
          How long until results?
          <Icon name="mdi:chevron-down" />
        </summary>
        <p class="mt-4 text-sm">
          SEO is not a sprint. Most clients see meaningful movement in three to four months.
        </p>
      </details>
    </div>
  </section>
</Layout>
