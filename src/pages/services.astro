---
import Layout from '@layouts/Common.astro'
import {Icon} from 'astro-icon/components'
---

<Layout>
  <!-- Hero Section -->
  <section class="md:split-2 breakout relative">
    <div class="item relative z-10 px-8 reveal up-8 duration-500">
      <p class="text-primary text-sm font-semibold">Results</p>
      <h1 class="mt-2 font-extrabold text-white">SEO that works</h1>
      <p class="mt-4 text-base text-white">
        We rank websites higher and drive real traffic to businesses that matter.
      </p>
      <div class="mt-6 flex gap-4">
        <button class="bg-primary rounded px-6 py-3 text-white">Free Audit</button>
        <button class="rounded border border-white px-6 py-3 text-white">Learn More</button>
      </div>
    </div>
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.pexels.com/photos/590022/pexels-photo-590022.jpeg?auto=compress&cs=tinysrgb&w=1600"
        alt="SEO analytics and search ranking data"
        class="size-full object-cover"
      />
      <div class="absolute inset-0 bg-black/60"></div>
    </div>
  </section>

  <!-- Service 1: On-page SEO -->
  <section class="md:split-2">
    <div class="item reveal left-12 duration-600 flex flex-col justify-center">
      <p class="text-primary text-sm font-semibold">On-page SEO</p>
      <h2 class="text-h2 mt-2 font-bold">On-page SEO that converts</h2>
      <p class="mt-4 text-base">
        Your site's foundation matters. We optimize every element to align with search intent and
        user behavior.
      </p>
      <ul class="mt-4 flex flex-col gap-2">
        <li class="flex items-center gap-2">
          <Icon name="mdi:star" class="text-primary" /> Keyword research and targeting
        </li>
        <li class="flex items-center gap-2">
          <Icon name="mdi:star" class="text-primary" /> Meta tag optimization for CTR
        </li>
        <li class="flex items-center gap-2">
          <Icon name="mdi:star" class="text-primary" /> Content structure and readability
        </li>
      </ul>
    </div>
    <div class="item reveal right-12 duration-600">
      <img
        src="https://images.pexels.com/photos/196644/pexels-photo-196644.jpeg?auto=compress&cs=tinysrgb&w=1200"
        alt="On-page SEO content optimization and keyword strategy"
        class="w-full rounded object-cover"
      />
    </div>
  </section>

  <!-- Service 2: Technical SEO -->
  <section class="md:split-2">
    <div class="item reveal left-12 duration-600">
      <img
        src="https://images.pexels.com/photos/1181467/pexels-photo-1181467.jpeg?auto=compress&cs=tinysrgb&w=1200"
        alt="Technical SEO site speed and crawlability"
        class="w-full rounded object-cover"
      />
    </div>
    <div class="item reveal right-12 duration-600 flex flex-col justify-center">
      <p class="text-primary text-sm font-semibold">Technical SEO</p>
      <h2 class="text-h2 mt-2 font-bold">Technical SEO that moves fast</h2>
      <p class="mt-4 text-base">
        Crawl errors, site speed, and mobile responsiveness are non-negotiable. We fix the
        infrastructure so Google can find and rank your pages.
      </p>
      <ul class="mt-4 flex flex-col gap-2">
        <li class="flex items-center gap-2">
          <Icon name="mdi:star" class="text-primary" /> Site speed optimization
        </li>
        <li class="flex items-center gap-2">
          <Icon name="mdi:star" class="text-primary" /> Mobile-first indexing fixes
        </li>
        <li class="flex items-center gap-2">
          <Icon name="mdi:star" class="text-primary" /> Schema markup implementation
        </li>
      </ul>
    </div>
  </section>

  <!-- Service 3: Content SEO -->
  <section class="md:split-2">
    <div class="item reveal left-12 duration-600 flex flex-col justify-center">
      <p class="text-primary text-sm font-semibold">Content Strategy</p>
      <h2 class="text-h2 mt-2 font-bold">Content that ranks and converts</h2>
      <p class="mt-4 text-base">
        We research what your audience actually searches for, then create content that answers their
        questions and moves them closer to buying.
      </p>
      <ul class="mt-4 flex flex-col gap-2">
        <li class="flex items-center gap-2">
          <Icon name="mdi:star" class="text-primary" /> Search intent mapping
        </li>
        <li class="flex items-center gap-2">
          <Icon name="mdi:star" class="text-primary" /> High-quality copywriting
        </li>
        <li class="flex items-center gap-2">
          <Icon name="mdi:star" class="text-primary" /> Content optimization & updates
        </li>
      </ul>
    </div>
    <div class="item reveal right-12 duration-600">
      <img
        src="https://images.pexels.com/photos/3182812/pexels-photo-3182812.jpeg?auto=compress&cs=tinysrgb&w=1200"
        alt="Content strategy and SEO copywriting"
        class="w-full rounded object-cover"
      />
    </div>
  </section>

  <!-- Stats Section -->
  <section class="md:split-2 items-center">
    <hgroup class="mx-auto mb-12 max-w-lg text-center reveal up-6 duration-500">
      <p class="text-primary text-sm font-semibold">Results</p>
      <h2 class="text-h2 mt-2 font-bold">What our work delivers</h2>
      <p class="mt-4 text-base">Real numbers from real clients across industries.</p>
    </hgroup>

    <div class="wrap gap-y-6">
      <div class="item flex flex-col gap-6 stagger-100ms">
        <div class="reveal up-6 duration-400 flex flex-col justify-center border border-black p-8 text-center dark:border-white">
          <p class="text-5xl font-extrabold text-black dark:text-white">47%</p>
          <p class="mt-2 text-sm font-bold text-black dark:text-white">Average ranking increase</p>
        </div>
        <div class="reveal up-6 duration-400 flex flex-col justify-center border border-black p-8 text-center dark:border-white">
          <p class="text-5xl font-extrabold text-black dark:text-white">156%</p>
          <p class="mt-2 text-sm font-bold text-black dark:text-white">Organic traffic growth</p>
        </div>
        <div class="reveal up-6 duration-400 flex flex-col justify-center border border-black p-8 text-center dark:border-white">
          <p class="text-5xl font-extrabold text-black dark:text-white">3.2x</p>
          <p class="mt-2 text-sm font-bold text-black dark:text-white">Return on investment</p>
        </div>
      </div>
      <div class="item reveal right-10 duration-600">
        <img
          src="https://images.pexels.com/photos/590020/pexels-photo-590020.jpeg?auto=compress&cs=tinysrgb&w=1200"
          alt="SEO performance metrics and analytics dashboard"
          class="aspect-[4/3] w-full rounded border border-black object-cover md:aspect-auto md:h-full dark:border-white"
        />
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section>
    <hgroup class="mx-auto max-w-lg text-center reveal up-6 duration-500">
      <h2>Questions</h2>
      <p class="text-base">Everything you need to know about how we work and what to expect</p>
    </hgroup>

    <div class="mx-auto mt-12 flex w-2xl max-w-full flex-col gap-4">
      <details class="reveal up-4 duration-400 w-full rounded border p-4">
        <summary class="flex cursor-pointer items-center justify-between font-bold">
          How long until results?
          <Icon name="mdi:chevron-down" />
        </summary>
        <p class="mt-4 text-sm">
          SEO is not a sprint. Most clients see meaningful movement in three to four months, with
          stronger gains by month six. We focus on sustainable growth, not quick fixes that fade.
        </p>
      </details>

      <details class="reveal up-4 duration-400 w-full rounded border p-4">
        <summary class="flex cursor-pointer items-center justify-between font-bold">
          What makes you different?
          <Icon name="mdi:chevron-down" />
        </summary>
        <p class="mt-4 text-sm">
          We don't use templates or automation. Every strategy is built from scratch based on your
          market, competitors, and goals.
        </p>
      </details>
    </div>
  </section>
</Layout>
